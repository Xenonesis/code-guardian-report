# =============================================================================
# CODE GUARDIAN — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# =============================================================================
# REQUIRED — App must have these to function
# =============================================================================

# Environment mode: development | production | test
NODE_ENV=development

# Neon Postgres connection string (Prisma datasource)
# Get this from Neon Console → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# NEON AUTH — Authentication (Optional but recommended)
# =============================================================================

# Neon Auth base URL — used by server-side auth handler
# Get from Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb"

# Neon Auth URL — used by client-side auth config (fallback)
NEON_AUTH_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/"

# Exposed to client-side
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/"

# Cookie signing secret for Neon Auth sessions
NEON_AUTH_COOKIE_SECRET="your-cookie-secret-at-least-32-chars-long"

# =============================================================================
# PUSH NOTIFICATIONS (PWA) — Web Push / VAPID
# =============================================================================

# VAPID public key — exposed to client for push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# VAPID private key — server-only, signs push messages
VAPID_PRIVATE_KEY="your-vapid-private-key"

# VAPID contact email (sent to push service as identifier)
VAPID_SUBJECT="mailto:admin@codeguardian.dev"

# =============================================================================
# GITHUB — OAuth & API Access
# =============================================================================

# GitHub OAuth App credentials (for GitHub Analysis feature)
# Create OAuth App at: https://github.com/settings/developers
NEXT_PUBLIC_GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
NEXT_PUBLIC_GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"

# GitHub personal access token (higher API rate limits, repo downloads)
GITHUB_TOKEN=""

# Optional: exposed client-side GitHub token
NEXT_PUBLIC_GITHUB_TOKEN=""

# GitHub repo reference (for contributor scripts, default: Xenonesis/code-guardian-report)
GITHUB_REPOSITORY="Xenonesis/code-guardian-report"

# Fallback GitHub token (used by scripts)
GH_TOKEN=""

# =============================================================================
# AI PROVIDERS — AI-Powered Analysis (Optional)
# =============================================================================

# OpenAI (GPT-4, GPT-3.5) — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Anthropic Claude (Claude 3 Opus, Sonnet) — https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (Gemini Pro) — https://makersuite.google.com/app/apikey
GEMINI_API_KEY="AI..."

# =============================================================================
# FIREBASE — Cloud Storage & Auth (Optional)
# =============================================================================

# Firebase Web App config — get from Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase Admin / Service Account (for MCP server setup)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# RATE LIMITING — Distributed Multi-Instance Support (Optional)
# =============================================================================

# Upstash Redis REST URL — for distributed rate limiting across instances
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================================================
# SCRIPTS
# =============================================================================

# Max top contributors to include in README (default: 8)
MAX_TOP_CONTRIBUTORS=8

# =============================================================================
# BUILD / RUNTIME (generally auto-set; override if needed)
# =============================================================================

# Server port (Docker default: 3000)
PORT=3000

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Application version (auto-resolved from package.json if not set)
NEXT_PUBLIC_APP_VERSION="11.0.0"

# Build timestamp (auto-set in next.config.ts)
NEXT_PUBLIC_BUILD_TIME=""
