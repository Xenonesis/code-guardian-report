{
  "name": "code-guardian-report",
  "private": true,
  "version": "15.5.0",
  "description": "Code analysis tool with security scanning and metrics reporting",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:prod": "npm run clean && npm run lint && npm run type-check && next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "lint:strict": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rimraf .next node_modules/.cache dist out",
    "clean:all": "rimraf .next node_modules/.cache dist out .turbo",
    "postbuild": "echo 'Build completed successfully!'",
    "prepare": "node -e \"if (!process.env.CI && !process.env.VERCEL) try { require('child_process').execSync('husky', { stdio: 'inherit' }) } catch (e) {}\"",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "ci:validate": "npm run lint:strict && npm run type-check && npm run test",
    "ci:build": "npm run ci:validate && npm run build",
    "docker:build": "docker build -t code-guardian:latest .",
    "docker:run": "docker run -p 3000:3000 code-guardian:latest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "deploy:vercel": "vercel --prod",
    "deploy:preview": "vercel",
    "mcp:build": "tsc -p tsconfig.mcp.json && tsc-alias -p tsconfig.mcp.json",
    "mcp:stdio": "node dist/mcp/mcp/transports/stdio.js",
    "mcp:http": "node dist/mcp/mcp/transports/http.js",
    "mcp:dev": "npx tsx src/mcp/transports/stdio.ts",
    "mcp:dev:http": "npx tsx src/mcp/transports/http.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node dist/mcp/mcp/transports/stdio.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,sh,html,xml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@lezer/cpp": "^1.1.6",
    "@lezer/java": "^1.1.3",
    "@lezer/python": "^1.1.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/api-client": "^2.7.3",
    "@neondatabase/auth": "^0.4.2-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/next": "^9.5.12",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__traverse": "^7.28.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "esbuild-wasm": "^0.28.1",
    "esprima": "^4.0.1",
    "esquery": "^1.7.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.23",
    "prisma": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "web-push": "^3.6.7",
    "web-tree-sitter": "^0.26.11",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "strip-comments": "^2.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "better-auth": "$better-auth",
    "@better-auth/passkey": {
      "better-auth": "$better-auth"
    },
    "fast-xml-parser": ">=5.7.0",
    "@tootallnate/once": ">=3.0.1",
    "dompurify": ">=3.4.0",
    "@hono/node-server": ">=1.19.13",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "yaml": ">=2.8.3",
    "uuid": ">=14.0.0",
    "next": {
      "postcss": ">=8.5.10"
    }
  }
}
